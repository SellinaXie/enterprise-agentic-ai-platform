APP_NAME="Enterprise AI Transformation Advisor"
# development | test | staging | production
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
LOG_EXCEPTION_TRACEBACKS=false

# Compose-only local PostgreSQL settings. Replace the password before shared use.
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=enterprise_ai
POSTGRES_TEST_DB=enterprise_ai_test
POSTGRES_PORT=5432
API_PORT=8000

# Required by persisted endpoints. Platforms should inject the complete production DSN as a
# secret; Compose constructs an internal DSN from the local POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://enterprise_ai:change-me@localhost:5432/enterprise_ai
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Optional integration-test database. Its name must contain "test" and it must not point to
# DATABASE_URL. The PostgreSQL test suite resets the application schema and deletes its own rows.
TEST_DATABASE_URL=

# Required by provider-backed assessment operations. Liveness never requires it. Set
# PROVIDER_REQUIRED=false only for local infrastructure smoke tests that make no provider calls.
OPENAI_API_KEY=replace-with-openai-key
PROVIDER_REQUIRED=true
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
# Keep provider-side response storage disabled by default for enterprise context.
OPENAI_STORE_RESPONSES=false

# V3 knowledge/RAG settings. Enable only after applying the pgvector migration and ingesting
# knowledge. text-embedding-3-small is requested at the schema-fixed 1,536 dimensions.
RAG_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_RETRIEVAL_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35

# V6 relational knowledge graph and hybrid GraphRAG. Disabled preserves all V1-V5 paths.
KNOWLEDGE_GRAPH_ENABLED=false
GRAPH_MAX_DEPTH=2
GRAPH_MAX_ENTITIES=20
GRAPH_MIN_CONFIDENCE=0.5

# V6.5 multipart document ingestion. Formats are a hard-coded security allowlist.
MAX_UPLOAD_SIZE_MB=10
PDF_MIN_EXTRACTED_CHARACTERS=100

# V4 controlled single-agent workflow. Disabled preserves the deterministic V3 path.
AGENTIC_WORKFLOW_ENABLED=false
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=5
# Outer LangGraph guard; when agentic mode is enabled this must be at least
# 2 * AGENT_MAX_STEPS + 3.
LANGGRAPH_RECURSION_LIMIT=25

# V5 controlled four-agent workflow. When enabled, this takes precedence over the V4 flag.
MULTI_AGENT_WORKFLOW_ENABLED=false
EVIDENCE_AGENT_MAX_STEPS=4
EVIDENCE_AGENT_MAX_TOOL_CALLS=4
MULTI_AGENT_MAX_FAILURES=2
# Number of bounded retries after the first schema-constrained specialist request.
SPECIALIST_RETRY_LIMIT=1

# V7C centralized post-generation risk gate. Disabled preserves V1-V7B behavior.
RUNTIME_RISK_GATE_ENABLED=false
RUNTIME_MEDIUM_RISK_DECISION=complete_with_warning
RUNTIME_HIGH_RISK_DECISION=require_human_review
RUNTIME_CRITICAL_RISK_DECISION=block_and_escalate
RUNTIME_REVIEW_ON_INSUFFICIENT_EVIDENCE=true
RUNTIME_REVIEW_ON_DEGRADED_EXECUTION=true
RUNTIME_REVIEW_ON_SPECIALIST_UNAVAILABLE=true
RUNTIME_REVIEW_ON_TOOL_FAILURE=true
RUNTIME_BLOCK_HIGH_RISK_INVALID_PROVENANCE=true
RUNTIME_BLOCK_CRITICAL_MISSING_MITIGATION=true
MAX_HUMAN_REVISIONS=2

# Bounded provider/tool resilience. Cost remains null unless both prices are configured.
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_DELAY_MS=250
MODEL_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10
GRAPH_EXTRACTION_TIMEOUT_SECONDS=30
# MODEL_INPUT_COST_PER_1M_TOKENS=0.00
# MODEL_OUTPUT_COST_PER_1M_TOKENS=0.00

# Production HTTP boundary. Use explicit origins/hosts; wildcard values are rejected in the
# production profile. JSON Content-Length is rejected above the configured application limit.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_JSON_REQUEST_SIZE_KB=256
REQUEST_ID_MAX_LENGTH=64
