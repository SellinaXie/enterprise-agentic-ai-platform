# Same-origin browser calls are proxied by Next.js to API_INTERNAL_URL.
NEXT_PUBLIC_API_BASE_URL=/backend

# Set in Vercel to the public HTTPS URL of the Render API service.
# This value is consumed by the server-side rewrite and is not an API credential.
API_INTERNAL_URL=https://replace-with-render-api.example

# Optional link from the public showcase to the authenticated application domain.
NEXT_PUBLIC_APP_URL=https://app.sellinaxie.com
